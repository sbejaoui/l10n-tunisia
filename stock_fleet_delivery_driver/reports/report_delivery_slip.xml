<odoo>
    <template
        id="report_delivery_slip_license_plate"
        inherit_id="stock.report_delivery_document"
    >
        <xpath expr="//div[@id='informations']" position="after">
            <div t-if="o.vehicle_id" class="mb-2">
                <strong>Immatriculation de la voiture:</strong>
                <span t-field="o.vehicle_id.license_plate" />
            </div>
        </xpath>
    </template>
</odoo>
