<odoo>
    <record id="is_stamp_tax" model="ir.ui.view">
        <field name="name">account.tax.form.stamp</field>
        <field name="model">account.tax</field>
        <field name="inherit_id" ref="account.view_tax_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//page[@name='advanced_options']//field[@name='is_base_affected']"
                position="after"
            >
                <field name="l10n_tn_is_stamp_tax" />
            </xpath>
        </field>
    </record>
</odoo>
