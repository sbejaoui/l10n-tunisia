<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="tax_group_stamp_tax" model="account.tax.group">
        <field name="name">Stamp Tax</field>
    </record>

    <record id="tax_stamp_sale" model="account.tax">
        <field name="name">Stamp Tax</field>
        <field name="amount_type">fixed</field>
        <field name="amount">1.0</field>
        <field name="active">False</field>
        <field name="type_tax_use">sale</field>
        <field name="tax_group_id" ref="tax_group_stamp_tax"/>
    </record>
    <record id="tax_stamp_purchase" model="account.tax">
        <field name="name">Stamp Tax</field>
        <field name="amount_type">fixed</field>
        <field name="amount">1.0</field>
        <field name="active">False</field>
        <field name="type_tax_use">purchase</field>
        <field name="tax_group_id" ref="tax_group_stamp_tax"/>
    </record>
</odoo>
