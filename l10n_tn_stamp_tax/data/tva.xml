<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="tax_group_tva" model="account.tax.group">
        <field name="name">TVA</field>
    </record>

    <record id="tax_tva_sale" model="account.tax">
        <field name="name">TVA</field>
        <field name="amount_type">percent</field>
        <field name="amount">19.0</field>
        <field name="active">True</field>
        <field name="type_tax_use">sale</field>
        <field name="invoice_label">TVA(19%)</field>
        <field name="tax_group_id" ref="tax_group_tva"/>
    </record>
    <record id="tax_tva_purchase" model="account.tax">
        <field name="name">TVA</field>
        <field name="amount_type">percent</field>
        <field name="amount">19.0</field>
        <field name="active">True</field>
        <field name="type_tax_use">purchase</field>
        <field name="invoice_label">TVA(19%)</field>
        <field name="tax_group_id" ref="tax_group_tva"/>
    </record>
</odoo>
