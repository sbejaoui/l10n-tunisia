msgid ""
"Use the bill collection wizard to record the payment evidence before "
"reconciling this effect."
msgstr "Utilisez l'assistant d'encaissement de la traite pour enregistrer le justificatif du paiement avant de lettrer cet effet."

#. module: l10n_tn_account_payment_bill_of_exchange
#. odoo-python
#: code:addons/l10n_tn_account_payment_bill_of_exchange/models/account_payment.py:0
msgid "Use the bill workflow actions."
msgstr "Utilisez les actions prévues pour la gestion de la traite."

#. module: l10n_tn_account_payment_bill_of_exchange
#. odoo-python
#: code:addons/l10n_tn_account_payment_bill_of_exchange/models/account_move_line.py:0
msgid "Use the bill workflow to correct its posted accounting lines."
msgstr "Utilisez les actions de la traite pour corriger ses lignes comptables comptabilisées."

#. module: l10n_tn_account_payment_bill_of_exchange
#. odoo-python
#: code:addons/l10n_tn_account_payment_bill_of_exchange/models/account_payment.py:0
msgid "Use the cancellation procedure and prepare a new bill."
msgstr "Utilisez la procédure d'annulation et préparez une nouvelle traite."

#. module: l10n_tn_account_payment_bill_of_exchange
#. odoo-python
#: code:addons/l10n_tn_account_payment_bill_of_exchange/models/account_move.py:0
msgid ""
"Use the documented bill operation instead of reversing its entry directly."
msgstr "Utilisez l'opération sur traite prévue au lieu de contrepasser directement son écriture."

#. module: l10n_tn_account_payment_bill_of_exchange
#. odoo-python
#: code:addons/l10n_tn_account_payment_bill_of_exchange/models/account_payment.py:0
msgid "Use the linked bill collection to modify this payment."
msgstr "Utilisez l'encaissement de traite associé pour modifier ce paiement."

#. module: l10n_tn_account_payment_bill_of_exchange
#. odoo-python
#: code:addons/l10n_tn_account_payment_bill_of_exchange/wizard/boe_operation.py:0
msgid "Use the recovery operation for an unpaid incident."
msgstr "Utilisez l'opération de recouvrement pour un incident d'impayé."

#. module: l10n_tn_account_payment_bill_of_exchange
#. odoo-python
#: code:addons/l10n_tn_account_payment_bill_of_exchange/models/account_partial_reconcile.py:0
msgid "Use the unpaid or cancellation action to reopen a bill invoice."
msgstr "Utilisez l'action de déclaration d'impayé ou d'annulation pour rouvrir une facture couverte par une traite."

