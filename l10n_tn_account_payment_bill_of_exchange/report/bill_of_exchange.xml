<odoo>
    <record id="report_bill" model="ir.actions.report">
        <field name="name">Lettre de change</field>
        <field name="model">account.payment</field>
        <field name="report_type">qweb-pdf</field>
        <field
            name="report_name"
        >l10n_tn_account_payment_bill_of_exchange.report_bill_document</field>
        <field name="binding_model_id" ref="account.model_account_payment" />
        <field name="binding_type">report</field>
        <field
            name="print_report_name"
        >'Traite - %s' % (object.boe_reference or object.name)</field>
    </record>
    <template id="report_bill_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-if="o.tn_boe" t-call="web.external_layout">
                    <div class="page">
                        <h1>Lettre de change</h1>
                        <p
                            t-if="o.state == 'draft'"
                            class="text-muted"
                        >Projet à faire signer — aucune preuve d'acceptation ou d'encaissement</p>
                        <p
                            t-else=""
                            class="text-muted"
                        >Copie de suivi — se référer au titre original signé</p>
                        <h3>Référence : <span t-field="o.boe_reference" /></h3>
                        <p>À l'échéance du <span t-field="o.boe_maturity_date" />,
                            veuillez payer à l'ordre de <strong
                            t-field="o.company_id.name"
                        />
                            la somme de <strong t-field="o.amount" />
                            (<span
                            t-out="o.currency_id.amount_to_text(o.amount)"
                        />).</p>
                        <table class="table table-borderless">
                            <tr>
                                <th>Tireur / bénéficiaire</th>
                                <td>
                                    <span
                                        t-field="o.company_id.partner_id"
                                        t-options="{'widget': 'contact', 'fields': ['name', 'address']}"
                                    />
                                </td>
                            </tr>
                            <tr>
                                <th>Tiré</th>
                                <td>
                                    <span
                                        t-field="o.partner_id"
                                        t-options="{'widget': 'contact', 'fields': ['name', 'address']}"
                                    />
                                </td>
                            </tr>
                            <tr>
                                <th>Date et lieu d'émission</th>
                                <td><span t-field="o.boe_issue_date" /> — <span
                                    t-field="o.boe_issue_place"
                                /></td>
                            </tr>
                            <tr>
                                <th>Lieu de paiement</th>
                                <td>
                                    <span t-field="o.boe_payment_place" />
                                </td>
                            </tr>
                            <tr>
                                <th>Domiciliation</th>
                                <td>
                                    <span t-field="o.partner_bank_id" />
                                </td>
                            </tr>
                        </table>
                        <div class="row mt-5">
                            <div class="col-6">
                                <strong>Signature du tireur</strong>
                            </div>
                            <div class="col-6">
                                <strong>Acceptation et signature du tiré</strong>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
