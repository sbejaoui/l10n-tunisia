<odoo>
    <record id="view_boe_incident_list" model="ir.ui.view">
        <field name="model">l10n_tn.boe.incident</field>
        <field name="arch" type="xml">
            <list create="0" delete="0" decoration-danger="recovery_residual &gt; 0">
                <field name="bill_id" />
                <field name="invoice_id" />
                <field name="partner_id" />
                <field name="date" />
                <field name="reason" />
                <field name="amount" sum="Retourné" />
                <field name="recovered_amount" sum="Recouvré" />
                <field name="transferred_amount" sum="Remplacé" />
                <field name="recovery_residual" sum="À recouvrer" />
                <field name="pending_amount" sum="Dont en attente" />
                <field name="currency_id" column_invisible="True" />
                <field name="responsible_id" />
                <button
                    name="action_recover"
                    type="object"
                    string="Recouvrer"
                    invisible="recovery_residual &lt;= pending_amount"
                    groups="account.group_account_invoice"
                />
            </list>
        </field>
    </record>
    <record id="view_boe_incident_form" model="ir.ui.view">
        <field name="model">l10n_tn.boe.incident</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <header>
                    <button
                        name="action_recover"
                        type="object"
                        string="Enregistrer un recouvrement"
                        invisible="recovery_residual &lt;= pending_amount"
                        groups="account.group_account_invoice"
                        class="oe_highlight"
                    />
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <group>
                        <field name="bill_id" />
                        <field name="invoice_id" />
                        <field name="date" />
                        <field name="reason" />
                        <field name="amount" />
                        <field name="recovered_amount" />
                        <field name="recovery_residual" />
                        <field name="pending_amount" />
                        <field name="replacement_bill_id" />
                        <field name="transferred_amount" />
                        <field name="currency_id" invisible="1" />
                        <field name="return_move_id" />
                        <field name="responsible_id" />
                    </group>
                    <field name="recovery_ids" readonly="1" />
                </sheet>
                <chatter />
            </form>
        </field>
    </record>
    <record id="action_boe_incidents" model="ir.actions.act_window">
        <field name="name">Impayés et recouvrement</field>
        <field name="res_model">l10n_tn.boe.incident</field>
        <field name="view_mode">list,form,pivot</field>
        <field name="domain">[('state', '=', 'posted')]</field>
    </record>
</odoo>
