<odoo>
    <record id="view_journal_boe" model="ir.ui.view">
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='inbound_payment_method_line_ids']/list/field[@name='payment_account_id']"
                position="before"
            >
                <field name="code" column_invisible="True" />
            </xpath>
            <xpath
                expr="//field[@name='inbound_payment_method_line_ids']/list/field[@name='payment_account_id']"
                position="attributes"
            >
                <attribute
                    name="domain"
                >[('account_type', '=', 'asset_receivable'), ('reconcile', '=', True)] if code == 'tn_bill_of_exchange' else ['|', ('account_type', 'in', ('asset_current', 'liability_current')), ('id', '=', parent.default_account_id)]</attribute>
            </xpath>
        </field>
    </record>
</odoo>
