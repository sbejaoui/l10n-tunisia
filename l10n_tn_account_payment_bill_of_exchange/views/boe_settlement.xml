<odoo>
    <record id="view_boe_collection_list" model="ir.ui.view">
        <field name="model">l10n_tn.boe.settlement</field>
        <field name="arch" type="xml">
            <list create="0" delete="0" decoration-warning="state == 'pending'">
                <field name="bill_id" />
                <field name="partner_id" />
                <field name="reference" />
                <field name="date" />
                <field name="amount" sum="Principal" />
                <field name="collected_amount" sum="Encaissé" />
                <field name="recovered_amount" sum="Recouvré" />
                <field name="currency_id" column_invisible="True" />
                <field name="state" widget="badge" />
                <field name="ready_to_confirm" />
                <button
                    name="action_confirm"
                    type="object"
                    string="Confirmer"
                    invisible="state != 'pending'"
                    groups="account.group_account_invoice"
                />
            </list>
        </field>
    </record>
    <record id="view_boe_collection_search" model="ir.ui.view">
        <field name="model">l10n_tn.boe.settlement</field>
        <field name="arch" type="xml">
            <search>
                <field name="bill_id" />
                <field name="partner_id" />
                <field name="reference" />
                <filter
                    name="pending"
                    string="En attente"
                    domain="[('state', '=', 'pending')]"
                />
                <filter
                    name="ready"
                    string="Prêts à confirmer"
                    domain="[('ready_to_confirm', '=', True)]"
                />
                <separator />
                <filter name="date" string="Date de règlement" date="date" />
                <filter
                    name="company"
                    string="Société"
                    context="{'group_by': 'company_id'}"
                />
            </search>
        </field>
    </record>
    <record id="view_boe_collection_pivot" model="ir.ui.view">
        <field name="model">l10n_tn.boe.settlement</field>
        <field name="arch" type="xml">
            <pivot string="Encaissements et recouvrements">
                <field name="date" type="row" interval="month" />
                <field name="collected_amount" type="measure" />
                <field name="recovered_amount" type="measure" />
            </pivot>
        </field>
    </record>
    <record id="view_boe_collection_form" model="ir.ui.view">
        <field name="model">l10n_tn.boe.settlement</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <header>
                    <button
                        name="action_confirm"
                        type="object"
                        string="Confirmer l'encaissement"
                        invisible="state != 'pending'"
                        groups="account.group_account_invoice"
                        class="oe_highlight"
                    />
                    <button
                        name="action_cancel"
                        type="object"
                        string="Contrepasser"
                        invisible="state == 'canceled' or not payment_id"
                        groups="account.group_account_manager"
                        confirm="Contrepasser le règlement et rétablir le solde à suivre ?"
                    />
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <group>
                        <field name="bill_id" />
                        <field name="incident_id" />
                        <field name="date" />
                        <field name="reference" />
                        <field name="amount" />
                        <field name="currency_id" invisible="1" />
                        <field name="payment_id" />
                        <field name="source_line_id" />
                        <field name="reversal_move_id" />
                        <field name="company_id" groups="base.group_multi_company" />
                    </group>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>
    <record id="action_boe_collections" model="ir.actions.act_window">
        <field name="name">Règlements des traites</field>
        <field name="res_model">l10n_tn.boe.settlement</field>
        <field name="view_mode">list,form,pivot</field>
        <field name="context">{'search_default_pending': True}</field>
        <field name="search_view_id" ref="view_boe_collection_search" />
    </record>
</odoo>
