<odoo>
    <record id="access_boe_operation_accountant" model="ir.model.access">
        <field name="name">boe.operation.accountant</field>
        <field name="model_id" ref="model_l10n_tn_boe_operation" />
        <field name="group_id" ref="account.group_account_invoice" />
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="True" />
        <field name="perm_create" eval="True" />
        <field name="perm_unlink" eval="False" />
    </record>
    <record id="rule_boe_operation_company" model="ir.rule">
        <field name="name">Bills operation: allowed companies</field>
        <field name="model_id" ref="model_l10n_tn_boe_operation" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
