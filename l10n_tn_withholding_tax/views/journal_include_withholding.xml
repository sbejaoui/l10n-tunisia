<odoo>
    <record id="journal_include_withholding" model="ir.ui.view">
        <field name="name">account.journal.form.journal_include_withholding</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='type']" position="after">
                <field name="l10n_tn_journal_include_withholding" />
            </xpath>
            <xpath
                expr="//field[@name='l10n_tn_journal_include_withholding']"
                position="after"
            >
                <field
                    name="l10n_tn_journal_amount"
                    widget="percentage"
                    invisible="not l10n_tn_journal_include_withholding"
                />
            </xpath>
        </field>
    </record>
</odoo>
