<odoo>
    <record id="journal_include_withholding" model="ir.ui.view">
        <field name="name">account.journal.form.journal_include_withholding</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='type']" position="after">
                <field name="is_withholding_tax_journal" />
            </xpath>
            <xpath expr="//field[@name='is_withholding_tax_journal']" position="after">
                <field
                    name="withholding_tax_rate"
                    widget="percentage"
                    invisible="not is_withholding_tax_journal"
                />
            </xpath>
        </field>
    </record>
</odoo>
