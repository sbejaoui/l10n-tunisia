<odoo>
    <record id="withholding_include_vat" model="ir.ui.view">
        <field name="name">account.tax.form.withholding_include_vat</field>
        <field name="model">account.tax</field>
        <field name="inherit_id" ref="account.view_tax_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='is_withholding_tax_on_payment']"
                position="after"
            >
                <field name="l10n_tn_withholding_tax_include_vat" />
            </xpath>
        </field>
    </record>
</odoo>
