<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_account_payment_register_withholding_tax_alert" model="ir.ui.view">
        <field name="name">account.payment.register.withholding.tax.alert</field>
        <field name="model">account.payment.register</field>
        <field name="inherit_id" ref="account.view_account_payment_register_form" />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='group1']/.." position="before">
                <div
                    class="alert alert-info"
                    role="alert"
                    invisible="not withholding_tax_alert"
                >
                    <field name="withholding_tax_alert" readonly="1" nolabel="1" />
                </div>
                <div
                    class="alert alert-warning"
                    role="alert"
                    invisible="not multiple_bills_alert"
                >
                    <field name="multiple_bills_alert" readonly="1" nolabel="1" />
                </div>
            </xpath>
        </field>
    </record>
</odoo>
