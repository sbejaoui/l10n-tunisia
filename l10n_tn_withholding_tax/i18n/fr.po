#. odoo-python
#: code:addons/l10n_tn_withholding_tax/wizard/account_payment_register.py:0
msgid "You are about to pay the withholding tax of multiple bills."
msgstr ""
"Vous êtes sur le point de payer la retenue à la source de plusieurs "
"factures."

#. module: l10n_tn_withholding_tax
#. odoo-python
#: code:addons/l10n_tn_withholding_tax/models/account_payment.py:0
msgid ""
"A withholding payment must use the fiscal account configured on its payment "
"method."
msgstr ""
"Un paiement de retenue doit utiliser le compte fiscal configuré sur sa "
"méthode de paiement."

#. module: l10n_tn_withholding_tax
#. odoo-python
#: code:addons/l10n_tn_withholding_tax/models/account_journal.py:0
msgid "A withholding tax journal must be a bank journal."
msgstr "Un journal de retenue à la source doit être de type Banque."

#. module: l10n_tn_withholding_tax
#. odoo-python
#: code:addons/l10n_tn_withholding_tax/models/account_journal.py:0
msgid ""
"Configure an active fiscal account for journal %(journal)s of type Current "
"Assets or Current Liabilities. It must belong to the journal company and "
"differ from the bank and transfer accounts."
msgstr ""
"Configurez un compte fiscal actif pour le journal %(journal)s, de type Actif"
" circulant ou Passif circulant. Il doit appartenir à la société du journal "
"et être distinct des comptes bancaire et de transfert."

#. module: l10n_tn_withholding_tax
#. odoo-python
#: code:addons/l10n_tn_withholding_tax/models/account_payment.py:0
msgid ""
"The withholding fiscal account currency must match the payment currency."
msgstr ""
"La devise du compte fiscal de retenue doit correspondre à celle du paiement."

#. module: l10n_tn_withholding_tax
#. odoo-python
#: code:addons/l10n_tn_withholding_tax/models/account_payment.py:0
msgid "The withholding journal entry must use the configured fiscal account."
msgstr "L’écriture de retenue doit utiliser le compte fiscal configuré."

#. module: l10n_tn_withholding_tax
#. odoo-python
#: code:addons/l10n_tn_withholding_tax/models/account_journal.py:0
msgid "The withholding rate must be greater than 0 and at most 1 (1 = 100%)."
msgstr ""
"Le taux de retenue doit être supérieur à 0 et inférieur ou égal à 1 (1 = 100"
" %)."

#. module: l10n_tn_withholding_tax
#. odoo-python
#: code:addons/l10n_tn_withholding_tax/models/account_payment.py:0
msgid ""
"A draft, canceled or rejected withholding payment cannot retain certificate "
"confirmation."
msgstr ""
"Un paiement de retenue en brouillon, annulé ou rejeté ne peut pas conserver "
"de confirmation de certificat."

#. module: l10n_tn_withholding_tax
#: model_terms:ir.ui.view,arch_db:l10n_tn_withholding_tax.journal_include_withholding
msgid "For a withholding rate of 1.5%, enter 1.5."
msgstr "Pour une retenue de 1,5 %, saisissez 1,5."

#. module: l10n_tn_withholding_tax
#: model_terms:ir.ui.view,arch_db:l10n_tn_withholding_tax.journal_include_withholding
msgid "Withholding rate"
