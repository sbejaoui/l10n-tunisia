<odoo>
    <record id="view_move_form_tax_exemption" model="ir.ui.view">
        <field name="name">account.move.form.tax.exemption</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//group[@name='accounting_info_group']/field[@name='fiscal_position_id']"
                position="after"
            >
                <field name="l10n_tn_tax_exemption_id" />
                <field name="l10n_tn_bon_de_commande_vise" />
                <field name="l10n_tn_bon_de_commande_vise_date" />
                <field name="l10n_tn_bon_de_commande_vise_filename" invisible="1" />
                <field
                    name="l10n_tn_bon_de_commande_vise_file"
                    widget="binary"
                    filename="l10n_tn_bon_de_commande_vise_filename"
                />
            </xpath>
        </field>
    </record>
</odoo>
