<odoo>
    <record id="view_partner_form_tax_exemption" model="ir.ui.view">
        <field name="name">res.partner.form.tax.exemption</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="account.view_partner_property_form" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='accounting']" position="inside">
                <group string="Tax Exemptions" name="l10n_tn_tax_exemptions">
                    <field name="l10n_tn_tax_exemption_ids" nolabel="1">
                        <list editable="bottom">
                            <field name="name" string="Attestation" />
                            <field name="date_start" />
                            <field name="date_end" />
                            <field name="fiscal_position_id" />
                        </list>
                    </field>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
