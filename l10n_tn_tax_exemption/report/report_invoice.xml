<odoo>
    <template
        id="report_invoice_document_tax_exemption"
        inherit_id="account.report_invoice_document"
    >
        <xpath expr="//p[@name='note']" position="after">
            <p
                t-if="o.l10n_tn_tax_exemption_id"
                name="l10n_tn_tax_exemption"
                class="mb-2"
            >
                Attestation n° <span t-field="o.l10n_tn_tax_exemption_id.name" />
                du <span t-field="o.l10n_tn_tax_exemption_id.date_start" />
                au <span t-field="o.l10n_tn_tax_exemption_id.date_end" />
            </p>
        </xpath>
    </template>
</odoo>
