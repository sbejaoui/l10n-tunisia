#. module: l10n_tn_tax_exemption
#. odoo-python
#: code:addons/l10n_tn_tax_exemption/models/account_move.py:0
msgid ""
"This customer was previously tax exempt. Certificate %(certificate)s expired"
" on %(date)s. Please check whether the customer is still exempt and request "
"an updated certificate."
msgstr ""
"Ce client bénéficiait auparavant d'une exonération fiscale. Le certificat "
"%(certificate)s a expiré le %(date)s. Veuillez vérifier si le client est "
"toujours exonéré et demander un certificat à jour."

#. module: l10n_tn_tax_exemption
#. odoo-python
#: code:addons/l10n_tn_tax_exemption/models/account_move.py:0
msgid ""
"Tunisian tax exemption is only available on customer invoices and credit "
"notes where both the company and the invoice partner are based in Tunisia."
msgstr ""
"L'exonération fiscale tunisienne s'applique uniquement aux factures et aux "
"avoirs clients lorsque la société et le partenaire de la facture sont tous "
"deux établis en Tunisie."

